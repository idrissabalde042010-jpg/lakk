{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lakk",
  "version": "0.1.0",
  "identifier": "sn.lakk.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lakk",
        "width": 432,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "auth-session": {
      "callbackUrlScheme": "lakk"
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/nexus/lakk/releases/latest/download/{{target}}/{{arch}}/{{current_version}}.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3REY4MTk4MUUyNDY4NDgKUldSSWFDUWVtSUhmNThkSk9UZzVKbHVBaHI5WG1DeHUxL29CbHJVUm5XdjlwQjFJbzU3OEoyUnMK"
    }
  }
}