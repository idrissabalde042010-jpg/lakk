# Variables d'environnement pour Lakk
# Copie ce fichier vers .env et remplis les valeurs

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
PUBLIC_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Apple OAuth (Apple Developer > Certificates, Identifiers & Profiles > Identifiers)
PUBLIC_APPLE_CLIENT_ID=your_apple_client_id_here
PUBLIC_APPLE_CLIENT_SECRET=your_apple_client_secret_here

# ⚠️ IMPORTANT : Ne commite JAMAIS le vrai fichier .env (dans .gitignore)
# Ces variables sont utilisées uniquement côté client (préfixe PUBLIC_)
# Pour la production, l'échange de code devrait se faire côté backend